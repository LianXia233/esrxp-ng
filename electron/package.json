{
  "name": "esrxp-ng",
  "productName": "esrxp-ng 硬字幕提取",
  "version": "0.4.3",
  "description": "esrXP 现代化重构：FFmpeg 解码 + Rust 引擎 + TDesign UI。从视频中提取硬字幕为 VobSub/SSA/OCR 位图。",
  "main": "main.js",
  "author": {
    "name": "LianXia233",
    "email": "a11879ab123@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:win:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ng.esrxp.hardsub",
    "productName": "esrxp-ng",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "server/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "../rust-backend/target/release/",
        "to": "server/",
        "filter": [
          "esrxp-ng-server*"
        ]
      },
      {
        "from": "../ui",
        "to": "ui"
      }
    ],
    "asarUnpack": [
      "server/**/*"
    ]
  },
  "homepage": "https://github.com/LianXia233/esrxp-ng"
}